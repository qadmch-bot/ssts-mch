# ─────────────────────────────────────────────────────────────────────────────
# SSTS environment variables. Leave Supabase vars EMPTY to run the demo mode
# (browser storage, synthetic data, no messages sent).
# Server-only secrets must NEVER be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (public URL + anon key are safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used by the notification worker and scheduled jobs
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/* and scheduled /api/notifications/dispatch (min 16 chars, random)
CRON_SECRET=

# Public HTTPS address of this application (used in secure case links; also set in Settings)
APP_BASE_URL=https://ssts.example.org

# WhatsApp Business Platform — Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=            # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=ssts_alert # approved template, 4 body variables (see docs/WHATSAPP.md)
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=              # verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string; enter the same value in Meta

# Email — EMAIL_PROVIDER=smtp (e.g. Microsoft 365) or resend
EMAIL_PROVIDER=
EMAIL_FROM="SSTS Alerts <ssts-alerts@example.org>"
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
